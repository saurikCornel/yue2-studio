diff --git a/src/lyra/music_tools/transcribe.py b/src/lyra/music_tools/transcribe.py
index c562991..e0c0555 100644
--- a/src/lyra/music_tools/transcribe.py
+++ b/src/lyra/music_tools/transcribe.py
@@ -35,7 +35,17 @@ def main():
     parser.add_argument('--task', choices=('full', 'melody-full', 'melody-vocal'), default='melody-full')
